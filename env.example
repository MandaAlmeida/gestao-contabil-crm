# ========================================
# Configuração do Firebase
# ========================================
# Obtenha essas chaves no Console do Firebase:
# https://console.firebase.google.com/
# Projeto > Configurações do Projeto > Seus apps > Configuração

# Chave da API do Firebase
VITE_FIREBASE_API_KEY=

# Domínio de autenticação do Firebase
VITE_FIREBASE_AUTH_DOMAIN=

# ID do projeto Firebase
VITE_FIREBASE_PROJECT_ID=

# Bucket de armazenamento do Firebase
VITE_FIREBASE_STORAGE_BUCKET=

# ID do remetente de mensagens
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ID do app Firebase
VITE_FIREBASE_APP_ID=

# ID de medição (opcional - apenas se usar Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=

# ========================================
# Configuração de Emuladores (Desenvolvimento)
# ========================================
# Use os emuladores locais do Firebase durante o desenvolvimento
# Para habilitar, defina como "true"
VITE_USE_FIREBASE_EMULATORS=false

# Host dos emuladores (padrão: 127.0.0.1 para localhost)
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

