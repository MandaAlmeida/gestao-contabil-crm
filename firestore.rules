rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar autenticação
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função auxiliar para validar campos obrigatórios de timestamp
    function hasValidTimestamps() {
      let data = request.resource.data;
      return 'createdAt' in data && 
             'updatedAt' in data &&
             data.createdAt is string &&
             data.updatedAt is string;
    }
    
    // Função auxiliar para proteger campos createdAt
    function createdAtUnchanged() {
      return resource.data.createdAt == request.resource.data.createdAt;
    }
    
    // ==================== CONTABILIDADES ====================
    match /contabilidades/{contabilidadeId} {
      // Permitir leitura para usuários autenticados
      allow read: if isAuthenticated();
      
      // Permitir criação para usuários autenticados com validação
      allow create: if isAuthenticated() &&
                      hasValidTimestamps() &&
                      request.resource.data.nome is string &&
                      request.resource.data.email is string &&
                      request.resource.data.nome.size() > 0 &&
                      request.resource.data.email.size() > 0 &&
                      (!('cnpj' in request.resource.data) || request.resource.data.cnpj is string);
      
      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated() &&
                      request.resource.data.updatedAt is string &&
                      createdAtUnchanged() &&
                      request.resource.data.nome is string &&
                      request.resource.data.email is string &&
                      request.resource.data.nome.size() > 0 &&
                      request.resource.data.email.size() > 0 &&
                      (!('cnpj' in request.resource.data) || request.resource.data.cnpj is string);
      
      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }
    
    // ==================== CLIENTES ====================
    match /clientes/{clienteId} {
      // Permitir leitura para usuários autenticados
      allow read: if isAuthenticated();
      
      // Permitir criação para usuários autenticados com validação
      allow create: if isAuthenticated() &&
                      hasValidTimestamps() &&
                      request.resource.data.nome is string &&
                      request.resource.data.cnpj is string &&
                      request.resource.data.cidade is string &&
                      request.resource.data.contato is string &&
                      request.resource.data.contabilidade is string &&
                      request.resource.data.responsavel is string &&
                      request.resource.data.observacoes is string &&
                      request.resource.data.nome.size() > 0 &&
                      request.resource.data.cnpj.size() > 0 &&
                      request.resource.data.cidade.size() > 0 &&
                      request.resource.data.contato.size() > 0 &&
                      request.resource.data.responsavel.size() > 0;
      
      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated() &&
                      request.resource.data.updatedAt is string &&
                      createdAtUnchanged() &&
                      request.resource.data.nome is string &&
                      request.resource.data.cnpj is string &&
                      request.resource.data.cidade is string &&
                      request.resource.data.contato is string &&
                      request.resource.data.contabilidade is string &&
                      request.resource.data.responsavel is string &&
                      request.resource.data.observacoes is string &&
                      request.resource.data.nome.size() > 0 &&
                      request.resource.data.cnpj.size() > 0 &&
                      request.resource.data.cidade.size() > 0 &&
                      request.resource.data.contato.size() > 0 &&
                      request.resource.data.responsavel.size() > 0;
      
      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }
    
    // ==================== FINANCEIRO ====================
    match /financeiro/{financeiroId} {
      // Campo valorServico: opcional, pode ser string ou null
      // Usado para armazenar o valor do serviço vinculado ao financeiro
      // Campo dataPagamento: opcional, pode ser string ou null (DEPRECATED)
      // Usado para armazenar quando o item foi marcado como pago
      // Campo historicoPagamentos: opcional, array de objetos com histórico de pagamentos
      // Cada objeto contém: dataVencimento, dataPagamento, emDia (boolean), meioPagamento

      // Permitir leitura para usuários autenticados
      allow read: if isAuthenticated();
      
      // Permitir criação para usuários autenticados com validação
      allow create: if isAuthenticated() &&
                      hasValidTimestamps() &&
                      request.resource.data.clienteId is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.clienteCNPJ is string &&
                      request.resource.data.dataVencimento is string &&
                      request.resource.data.valorMensalidade is number &&
                      request.resource.data.status is string &&
                      request.resource.data.meioPagamento is string &&
                      request.resource.data.observacoes is string &&
                      (!('valorServico' in request.resource.data) ||
                       request.resource.data.valorServico is string ||
                       request.resource.data.valorServico == null) &&
                      (!('dataPagamento' in request.resource.data) ||
                       request.resource.data.dataPagamento is string ||
                       request.resource.data.dataPagamento == null) &&
                      (!('historicoPagamentos' in request.resource.data) ||
                       request.resource.data.historicoPagamentos is list) &&
                      request.resource.data.clienteId.size() > 0 &&
                      request.resource.data.status in ['Pago', 'Pendente', 'Vencido'] &&
                      request.resource.data.meioPagamento in ['Pix', 'Boleto'] &&
                      request.resource.data.valorMensalidade >= 0;
      
      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated() &&
                      request.resource.data.updatedAt is string &&
                      createdAtUnchanged() &&
                      request.resource.data.clienteId is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.clienteCNPJ is string &&
                      request.resource.data.dataVencimento is string &&
                      request.resource.data.valorMensalidade is number &&
                      request.resource.data.status is string &&
                      request.resource.data.meioPagamento is string &&
                      request.resource.data.observacoes is string &&
                      (!('valorServico' in request.resource.data) ||
                       request.resource.data.valorServico is string ||
                       request.resource.data.valorServico == null) &&
                      (!('dataPagamento' in request.resource.data) ||
                       request.resource.data.dataPagamento is string ||
                       request.resource.data.dataPagamento == null) &&
                      (!('historicoPagamentos' in request.resource.data) ||
                       request.resource.data.historicoPagamentos is list) &&
                      request.resource.data.clienteId.size() > 0 &&
                      request.resource.data.status in ['Pago', 'Pendente', 'Vencido'] &&
                      request.resource.data.meioPagamento in ['Pix', 'Boleto'] &&
                      request.resource.data.valorMensalidade >= 0;
      
      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }
    
    // ==================== CERTIFICADOS ====================
    match /certificados/{certificadoId} {
      // Permitir leitura para usuários autenticados
      allow read: if isAuthenticated();
      
      // Permitir criação para usuários autenticados com validação
      allow create: if isAuthenticated() &&
                      hasValidTimestamps() &&
                      request.resource.data.clienteId is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.clienteCNPJ is string &&
                      request.resource.data.tipoCertificado is string &&
                      request.resource.data.dataVencimento is string &&
                      request.resource.data.status is string &&
                      request.resource.data.observacoes is string &&
                      request.resource.data.clienteId.size() > 0 &&
                      request.resource.data.tipoCertificado in ['A1', 'A3'] &&
                      request.resource.data.status in ['Pendente', 'Avisado', 'Renovado'];
      
      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated() &&
                      request.resource.data.updatedAt is string &&
                      createdAtUnchanged() &&
                      request.resource.data.clienteId is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.clienteCNPJ is string &&
                      request.resource.data.tipoCertificado is string &&
                      request.resource.data.dataVencimento is string &&
                      request.resource.data.status is string &&
                      request.resource.data.observacoes is string &&
                      request.resource.data.clienteId.size() > 0 &&
                      request.resource.data.tipoCertificado in ['A1', 'A3'] &&
                      request.resource.data.status in ['Pendente', 'Avisado', 'Renovado'];
      
      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }
    
    // ==================== SINTEGRA ====================
    match /sintegra/{sintegraId} {
      // Campo dataPagamento: opcional, pode ser string ou null (DEPRECATED)
      // Usado para armazenar quando o item foi marcado como concluído
      // Campo historicoAtividades: opcional, array de objetos com histórico de atividades
      
      // Permitir leitura para usuários autenticados
      allow read: if isAuthenticated();
      
      // Permitir criação para usuários autenticados com validação
      allow create: if isAuthenticated() &&
                      hasValidTimestamps() &&
                      request.resource.data.clienteId is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.dataPrazo is string &&
                      request.resource.data.acesso is string &&
                      request.resource.data.status is string &&
                      request.resource.data.observacoes is string &&
                      request.resource.data.clienteId.size() > 0 &&
                      request.resource.data.status in ['Pendente', 'Concluído', 'Vencido'] &&
                      (!('dataPagamento' in request.resource.data) ||
                       request.resource.data.dataPagamento is string ||
                       request.resource.data.dataPagamento == null) &&
                      (!('historicoAtividades' in request.resource.data) ||
                       request.resource.data.historicoAtividades is list);
      
      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated() &&
                      request.resource.data.updatedAt is string &&
                      createdAtUnchanged() &&
                      request.resource.data.clienteId is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.dataPrazo is string &&
                      request.resource.data.acesso is string &&
                      request.resource.data.status is string &&
                      request.resource.data.observacoes is string &&
                      request.resource.data.clienteId.size() > 0 &&
                      request.resource.data.status in ['Pendente', 'Concluído', 'Vencido'] &&
                      (!('dataPagamento' in request.resource.data) ||
                       request.resource.data.dataPagamento is string ||
                       request.resource.data.dataPagamento == null) &&
                      (!('historicoAtividades' in request.resource.data) ||
                       request.resource.data.historicoAtividades is list);
      
      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }
    
    // ==================== DESPESAS ====================
    match /despesas/{despesaId} {
      // Campo dataPagamento: opcional, pode ser string ou null
      // Campo atrasado: opcional, indica se foi pago fora do mês de vencimento
      
      // Permitir leitura para usuários autenticados
      allow read: if isAuthenticated();
      
      // Permitir criação para usuários autenticados com validação
      allow create: if isAuthenticated() &&
                      hasValidTimestamps() &&
                      request.resource.data.descricao is string &&
                      request.resource.data.valor is number &&
                      request.resource.data.data is string &&
                      request.resource.data.fixo is bool &&
                      request.resource.data.pago is bool &&
                      request.resource.data.descricao.size() > 0 &&
                      request.resource.data.valor >= 0 &&
                      (!('dataPagamento' in request.resource.data) || request.resource.data.dataPagamento is string || request.resource.data.dataPagamento == null) &&
                      (!('atrasado' in request.resource.data) || request.resource.data.atrasado is bool);
      
      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated() &&
                      request.resource.data.updatedAt is string &&
                      createdAtUnchanged() &&
                      request.resource.data.descricao is string &&
                      request.resource.data.valor is number &&
                      request.resource.data.data is string &&
                      request.resource.data.fixo is bool &&
                      request.resource.data.pago is bool &&
                      request.resource.data.descricao.size() > 0 &&
                      request.resource.data.valor >= 0 &&
                      (!('dataPagamento' in request.resource.data) || request.resource.data.dataPagamento is string || request.resource.data.dataPagamento == null) &&
                      (!('atrasado' in request.resource.data) || request.resource.data.atrasado is bool);
      
      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }
    
    // ==================== SERVICOS ====================
    match /servicos/{servicoId} {
      // Campo dataPagamento: opcional, pode ser string ou null
      // Usado para armazenar quando o item foi marcado como pago
      
      // Permitir leitura para usuários autenticados
      allow read: if isAuthenticated();
      
      // Permitir criação para usuários autenticados com validação
      allow create: if isAuthenticated() &&
                      hasValidTimestamps() &&
                      request.resource.data.clienteId is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.clienteCNPJ is string &&
                      request.resource.data.responsavel is string &&
                      request.resource.data.descricao is string && 
                      request.resource.data.dataVencimento is string &&
                      request.resource.data.valorMensalidade is number &&
                      request.resource.data.status is string &&
                      request.resource.data.meioPagamento is string &&
                      request.resource.data.observacoes is string &&
                      request.resource.data.ativo is bool &&
                      (!('dataPagamento' in request.resource.data) ||
                       request.resource.data.dataPagamento is string ||
                       request.resource.data.dataPagamento == null) &&
                      request.resource.data.clienteId.size() > 0 &&
                      request.resource.data.responsavel.size() > 0 &&
                      request.resource.data.status in ['Pago', 'Pendente', 'Vencido'] &&
                      request.resource.data.meioPagamento in ['Pix', 'Boleto'] &&
                      request.resource.data.valorMensalidade >= 0;
      
      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated() &&
                      request.resource.data.updatedAt is string &&
                      createdAtUnchanged() &&
                      request.resource.data.clienteId is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.clienteCNPJ is string &&
                      request.resource.data.responsavel is string &&
                      request.resource.data.descricao is string &&
                      request.resource.data.dataVencimento is string &&
                      request.resource.data.valorMensalidade is number &&
                      request.resource.data.status is string &&
                      request.resource.data.meioPagamento is string &&
                      request.resource.data.observacoes is string &&
                      request.resource.data.ativo is bool &&
                      (!('dataPagamento' in request.resource.data) ||
                       request.resource.data.dataPagamento is string ||
                       request.resource.data.dataPagamento == null) &&
                      request.resource.data.clienteId.size() > 0 &&
                      request.resource.data.responsavel.size() > 0 &&
                      request.resource.data.status in ['Pago', 'Pendente', 'Vencido'] &&
                      request.resource.data.meioPagamento in ['Pix', 'Boleto'] &&
                      request.resource.data.valorMensalidade >= 0;
      
      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }
    
    // ==================== RENOVACAO ====================
    match /renovacao/{renovacaoId} {
      // Permitir leitura para usuários autenticados
      allow read: if isAuthenticated();
      
      // Permitir criação para usuários autenticados com validação
      allow create: if isAuthenticated() &&
                      hasValidTimestamps() &&
                      request.resource.data.clienteId is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.clienteCNPJ is string &&
                      request.resource.data.dataRenovacao is string &&
                      request.resource.data.valorRenovacao is number &&
                      request.resource.data.status is string &&
                      request.resource.data.observacoes is string &&
                      request.resource.data.clienteId.size() > 0 &&
                      request.resource.data.status in ['Pendente', 'Avisado', 'Em Negociação', 'Parcelado', 'Renovado', 'Cancelado'] &&
                      (!('parcela' in request.resource.data) || request.resource.data.parcela == null || (request.resource.data.parcela is string && request.resource.data.parcela in ['1 Vez', '2 Vezes', '3 Vezes'])) &&
                      request.resource.data.valorRenovacao >= 0;
      
      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated() &&
                      request.resource.data.updatedAt is string &&
                      createdAtUnchanged() &&
                      request.resource.data.clienteId is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.clienteCNPJ is string &&
                      request.resource.data.dataRenovacao is string &&
                      request.resource.data.valorRenovacao is number &&
                      request.resource.data.status is string &&
                      request.resource.data.observacoes is string &&
                      request.resource.data.clienteId.size() > 0 &&
                      request.resource.data.status in ['Pendente', 'Avisado', 'Em Negociação', 'Parcelado', 'Renovado', 'Cancelado'] &&
                      (!('parcela' in request.resource.data) || request.resource.data.parcela == null || (request.resource.data.parcela is string && request.resource.data.parcela in ['1 Vez', '2 Vezes', '3 Vezes'])) &&
                      request.resource.data.valorRenovacao >= 0;
      
      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }
    
    // ==================== USUÁRIOS ====================
    match /usuarios/{usuarioId} {
      // Permitir leitura para usuários autenticados
      allow read: if isAuthenticated();

      // Permitir criação para usuários autenticados
      // Permite que qualquer usuário autenticado crie um registro de usuário
      allow create: if isAuthenticated() &&
                      request.resource.data.nome is string &&
                      request.resource.data.email is string &&
                      request.resource.data.ativo is bool &&
                      request.resource.data.nome.size() > 0 &&
                      request.resource.data.email.size() > 0 &&
                      ('createdAt' in request.resource.data) &&
                      ('updatedAt' in request.resource.data) &&
                      request.resource.data.createdAt is string &&
                      request.resource.data.updatedAt is string;

      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated() &&
                     request.resource.data.nome is string &&
                     request.resource.data.email is string &&
                     request.resource.data.ativo is bool &&
                     request.resource.data.nome.size() > 0 &&
                     request.resource.data.email.size() > 0 &&
                     ('updatedAt' in request.resource.data) &&
                     request.resource.data.updatedAt is string &&
                     (resource == null || resource.data.createdAt == request.resource.data.createdAt) &&
                     (!('telefone' in request.resource.data) || request.resource.data.telefone is string);

      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }

    // ==================== USER PREFERENCES ====================
    match /userPreferences/{userId} {
      // Permitir leitura apenas para o próprio usuário
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Permitir criação e atualização apenas para o próprio usuário
      allow create, update: if isAuthenticated() &&
                            request.auth.uid == userId &&
                            (!('viewedNotifications' in request.resource.data) ||
                             request.resource.data.viewedNotifications is map) &&
                            (!('updatedAt' in request.resource.data) ||
                             request.resource.data.updatedAt is number);

      // Permitir exclusão apenas para o próprio usuário
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ==================== NOTIFICATIONS ====================
    match /notifications/{notificationId} {
      // Permitir leitura apenas para usuários autenticados
      allow read: if isAuthenticated();

      // Permitir criação para usuários autenticados com validação
      allow create: if isAuthenticated() &&
                      hasValidTimestamps() &&
                      request.resource.data.userId is string &&
                      request.resource.data.itemId is string &&
                      request.resource.data.type is string &&
                      request.resource.data.title is string &&
                      request.resource.data.message is string &&
                      request.resource.data.daysRemaining is number &&
                      request.resource.data.priority is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.userId.size() > 0 &&
                      request.resource.data.itemId.size() > 0 &&
                      request.resource.data.type in ['certificado', 'pagamento', 'servico', 'renovacao', 'sintegra', 'despesa'] &&
                      request.resource.data.priority in ['high', 'medium', 'low'];

      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated() &&
                      request.resource.data.updatedAt is string &&
                      createdAtUnchanged() &&
                      request.resource.data.userId is string &&
                      request.resource.data.itemId is string &&
                      request.resource.data.type is string &&
                      request.resource.data.title is string &&
                      request.resource.data.message is string &&
                      request.resource.data.daysRemaining is number &&
                      request.resource.data.priority is string &&
                      request.resource.data.clienteNome is string &&
                      request.resource.data.userId.size() > 0 &&
                      request.resource.data.itemId.size() > 0;

      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }

    // ==================== NOTIFICATION VIEWS ====================
    match /notificationViews/{viewId} {
      // Permitir leitura apenas para o próprio usuário
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;

      // Permitir criação apenas para o próprio usuário
      allow create: if isAuthenticated() &&
                      request.auth.uid == request.resource.data.userId &&
                      request.resource.data.notificationId is string &&
                      request.resource.data.viewedAt is string &&
                      request.resource.data.notificationId.size() > 0;

      // Permitir exclusão para usuários autenticados (necessário para limpar visualizações ao excluir notificações)
      allow delete: if isAuthenticated();
      
      // Não permitir atualização (visualizações são imutáveis)
      allow update: if false;
    }
    
    // ==================== ANOTACOES ====================
    match /anotacoes/{anotacaoId} {
      // Permitir leitura para usuários autenticados
      allow read: if isAuthenticated();
      // Permitir criação para usuários autenticados
      allow create: if isAuthenticated();
      // Permitir atualização para usuários autenticados
      allow update: if isAuthenticated();
      // Permitir exclusão para usuários autenticados
      allow delete: if isAuthenticated();
    }
    
    // Negar todas as outras operações por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

